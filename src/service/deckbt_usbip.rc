#include <windows.h>
#include "build_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DECKBT_VERSION_NUMERIC
 PRODUCTVERSION DECKBT_VERSION_NUMERIC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "DeckBtService: Steam Deck OLED Bluetooth over USB/IP\0"
            VALUE "FileVersion", DECKBT_VERSION "\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 DeckBtService Contributors. MIT License.\0"
            VALUE "ProductName", "DeckBtService\0"
            VALUE "ProductVersion", DECKBT_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
